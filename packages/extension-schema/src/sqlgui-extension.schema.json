{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlgui.dev/schemas/sqlgui.extension.schema.json",
  "title": "SQL GUI Extension Manifest",
  "type": "object",
  "required": ["name", "publisher", "version"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Extension identifier, must be lowercase alphanumeric with hyphens"
    },
    "displayName": {
      "type": "string",
      "description": "Human-readable display name"
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Publisher identifier"
    },
    "version": {
      "type": "string",
      "description": "Semantic version"
    },
    "description": {
      "type": "string",
      "description": "Extension description"
    },
    "main": {
      "type": "string",
      "description": "Entry point relative to extension root"
    },
    "icon": {
      "type": "string",
      "description": "Icon path relative to extension root"
    },
    "engines": {
      "type": "object",
      "properties": {
        "sqlgui": {
          "type": "string",
          "description": "SQL GUI version constraint"
        }
      }
    },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "activationEvents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "editor.read",
          "editor.write",
          "storage.local",
          "ui.notification",
          "db.connection.read",
          "db.schema.read",
          "db.query.read",
          "db.query.write",
          "db.query.explain",
          "network.fetch",
          "clipboard.read",
          "clipboard.write"
        ]
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "title"],
            "properties": {
              "command": {
                "type": "string",
                "description": "Command identifier, must be namespaced"
              },
              "title": {
                "type": "string",
                "description": "Human-readable title"
              },
              "category": {
                "type": "string",
                "description": "Command category for grouping"
              },
              "icon": {
                "type": "string",
                "description": "Icon identifier"
              }
            }
          }
        },
        "menus": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["command"],
              "properties": {
                "command": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "when": {
                  "type": "string"
                },
                "group": {
                  "type": "string"
                },
                "order": {
                  "type": "number"
                }
              }
            }
          }
        },
        "keybindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "key"],
            "properties": {
              "command": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "mac": {
                "type": "string"
              },
              "win": {
                "type": "string"
              },
              "linux": {
                "type": "string"
              },
              "when": {
                "type": "string"
              }
            }
          }
        },
        "views": {
          "type": "object",
          "description": "View contributions organized by location",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique view identifier"
                },
                "name": {
                  "type": "string",
                  "description": "Human-readable view name"
                },
                "icon": {
                  "type": "string",
                  "description": "Icon identifier"
                },
                "when": {
                  "type": "string",
                  "description": "Visibility condition"
                }
              }
            }
          }
        }
      }
    }
  }
}
